# Skills that do not ship. Publication is gated by the allowlist in the local
# agents-setup (publish-skills.txt), so none of these are linked here; this
# list is the second guard, and scripts/check-private-skill-refs.sh reads it
# to catch dead pointers to them. `svgl` is private too but is left out: its
# name matches every svgl.app URL and would fail the check.

# CSC, Rahti and other platform-specific skills
skills/csc-allas/
skills/csc-lumi/
skills/csc-rahti/
skills/csc-roihu/
skills/rahti-audit/
skills/vercel-optimize/

# Personal tooling and meta-skills
skills/dev-toolchain/
skills/env/
skills/go-ui/
skills/improving-skills/
skills/project-docs/
skills/skill-finder/
skills/slack-message/
skills/ui-signature/

# Third-party or narrow skills kept out of this collection
skills/design-taste-frontend/
skills/excalidraw-diagram/
skills/jev-builder/
skills/mcp-eval/
skills/media-gen/
skills/paradedb-skill/
skills/turborepo/
skills/typesafe-ai/

# The private-skill reference check and its hook. They exist only because
# `skills/` holds junctions into a larger local collection on this machine — a
# clone has no junctions, no private skills, and so cannot make the mistake
# they catch.
/scripts/
/.githooks/
